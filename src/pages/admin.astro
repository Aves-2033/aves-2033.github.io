---
import BaseLayout from '../layouts/BaseLayout.astro';
import fs from 'node:fs';
import path from 'node:path';

// Security: Block in production — redirect to 404
if (import.meta.env.PROD) {
  return Astro.redirect('/404', 404);
}

const productsPath = path.resolve(process.cwd(), 'src/data/products.json');
const products = JSON.parse(fs.readFileSync(productsPath, 'utf-8').replace(/^\uFEFF/, ''));

const title = "Админ-панель | Прокат от Кет";
---

<BaseLayout title={title} description="Управление каталогом товаров" canonicalUrl="https://ketrent.ru/admin">
  <div class="admin-container" slot="default">
    <header class="admin-header">
      <h1>Управление каталогом</h1>
      <div class="admin-auth-badge">Development Mode</div>
    </header>

    <div class="admin-grid">
      <!-- Список товаров -->
      <aside class="admin-sidebar">
        <div class="search-box">
          <input type="text" id="productSearch" placeholder="Поиск по названию или ID..." />
          <select id="categoryFilter">
            <option value="all">Все категории</option>
            <option value="ball">Бальные платья XVIII-XIX век</option>
            <option value="vintage">Винтажные и свадебные платья</option>
            <option value="fashion">Фэшн и Будуар</option>
            <option value="medieval">Средневековые и Сказочные платья</option>
            <option value="ethnic-costumes">Этнические Костюмы</option>
            <option value="kimono">Японские кимоно женские</option>
            <option value="riding">Костюмы для Верховой езды</option>
            <option value="mens">Мужской Гардероб</option>
            <option value="cloaks">Плащи и Накидки</option>
            <option value="ethnic">Этнические украшения</option>
            <option value="accessories">Аксессуары</option>
            <option value="gloves-fans">Перчатки и веера</option>
            <option value="belt-shoes">Пояса и Обувь</option>
            <option value="furs">Мех</option>
            <option value="headwear">Головные Уборы</option>
            <option value="kids">Детские Костюмы</option>
          </select>
          <button id="openAddModalBtn" class="btn-primary" style="margin-top: 10px; width: 100%;">+ Добавить товар</button>
        </div>
        <div class="product-list" id="productList">
          {products.map(p => (
            <button class="product-item" data-id={p.id} data-title={p.title.toLowerCase()} data-category={p.category}>
              <div class="p-info">
                <span class="p-id">#{p.id}</span>
                <span class="p-title">{p.title}</span>
              </div>
              <span class="p-cat-tag">{p.category}</span>
            </button>
          ))}
        </div>
      </aside>

      <!-- Форма редактирования -->
      <main class="admin-main">
        <div id="noSelection" class="empty-state">
           <p>Выберите товар из списка слева, чтобы начать редактирование</p>
        </div>

        <div id="editor" class="product-editor hidden">
          <section class="editor-section info-section">
            <h2>Основная информация</h2>
            <form id="infoForm">
              <input type="hidden" name="productId" id="editProductId" />
              <div class="form-group">
                <label>Название</label>
                <input type="text" name="title" id="editTitle" required />
              </div>
              <div class="form-row">
                <div class="form-group">
                  <label>Цена (₽)</label>
                  <input type="number" name="price" id="editPrice" required />
                </div>
                <div class="form-group">
                  <label>Категория</label>
                  <select name="category" id="editCategory">
                    <option value="ball">Бальные платья XVIII-XIX век</option>
                    <option value="vintage">Винтажные и свадебные платья</option>
                    <option value="fashion">Фэшн и Будуар</option>
                    <option value="medieval">Средневековые и Сказочные платья</option>
                    <option value="ethnic-costumes">Этнические Костюмы</option>
                    <option value="kimono">Японские кимоно женские</option>
                    <option value="riding">Костюмы для Верховой езды</option>
                    <option value="mens">Мужской Гардероб</option>
                    <option value="cloaks">Плащи и Накидки</option>
                    <option value="ethnic">Этнические украшения</option>
                    <option value="accessories">Аксессуары</option>
                    <option value="gloves-fans">Перчатки и веера</option>
                    <option value="belt-shoes">Пояса и Обувь</option>
                    <option value="furs">Мех</option>
                    <option value="headwear">Головные Уборы</option>
                    <option value="kids">Детские Костюмы</option>
                  </select>
                </div>
              </div>
              <div class="form-group">
                <label>Описание</label>
                <textarea name="description" id="editDescription" rows="4"></textarea>
              </div>
              
              <h3>Характеристики (Details)</h3>
              <div id="detailsContainer" class="details-editor">
                <!-- Сюда добавятся поля динамически -->
              </div>
              <div class="details-actions-row">
                <button type="button" id="addDetailBtn" class="btn-secondary">+ Добавить поле</button>
                <button type="button" id="fillPresetBtn" class="btn-secondary">✨ Заполнить шаблон для категории</button>
              </div>
              <datalist id="detailsKeyPresets">
                <option value="Размер"></option>
                <option value="Рост"></option>
                <option value="Обхват груди"></option>
                <option value="Обхват талии"></option>
                <option value="Обхват бедер"></option>
                <option value="Длина"></option>
                <option value="Длина юбки"></option>
                <option value="Комплектация"></option>
                <option value="Корсет"></option>
                <option value="Материал"></option>
                <option value="Цвет"></option>
                <option value="Эпоха"></option>
                <option value="Стиль"></option>
                <option value="Культура/Регион"></option>
                <option value="Тип меха"></option>
                <option value="Состояние"></option>
              </datalist>

              <div class="form-actions">
                <button type="submit" class="btn-primary">Сохранить изменения</button>
                <button type="button" id="deleteProductBtn" class="btn-danger">Удалить товар целиком</button>
              </div>
            </form>
          </section>

          <section class="editor-section gallery-section">
            <h2>Галерея изображений</h2>
            <p class="gallery-hint">💡 Совет: перетаскивайте фотографии мышью (Drag & Drop), чтобы изменить их порядок. Первое фото всегда главное.</p>
            <div id="galleryGrid" class="admin-gallery-grid">
              <!-- Изображения -->
            </div>
            
            <div class="gallery-add-tools">
              <h3>Добавить фото</h3>
              <div class="tabs">
                <button class="tab-btn active" data-tab="upload">Загрузить файлы</button>
                <button class="tab-btn" data-tab="url">По ссылке</button>
              </div>
              
              <div id="uploadTab" class="tab-content active">
                <div id="uploadDropzone" class="upload-dropzone">
                  <div class="dropzone-prompt">
                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-bottom: 6px; color: #b39162;">
                      <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                      <polyline points="17 8 12 3 7 8"></polyline>
                      <line x1="12" y1="3" x2="12" y2="15"></line>
                    </svg>
                    <p style="margin: 0; font-weight: 500;">Перетащите фотографии сюда или нажмите для выбора</p>
                    <span class="dropzone-subtext">Поддерживается выбор нескольких фото сразу (JPG, PNG, WebP)</span>
                  </div>
                  <input type="file" id="fileInput" accept="image/*" multiple class="dropzone-file-input" />
                </div>
                <div id="uploadProgress" class="upload-progress hidden">
                  <div class="progress-bar-wrapper">
                    <div id="uploadProgressBar" class="progress-bar-fill"></div>
                  </div>
                  <span id="uploadProgressText">Загрузка...</span>
                </div>
              </div>

              <div id="urlTab" class="tab-content">
                <div class="input-group">
                  <input type="url" id="imgUrlInput" placeholder="https://..." />
                  <button id="addUrlBtn" class="btn-primary">Добавить</button>
                </div>
              </div>
            </div>
          </section>
        </div>
      </main>
    </div>

    <!-- Модалка создания товара -->
    <div id="addProductModal" class="admin-modal hidden">
      <div class="admin-modal-content">
        <header class="admin-modal-header">
          <h2>Добавить новый товар</h2>
          <button id="closeModalBtn" class="btn-close">&times;</button>
        </header>
        <form id="addProductForm" class="admin-modal-form">
          <div class="form-group">
            <label>Название товара</label>
            <input type="text" id="newTitle" name="title" required placeholder="Например: Историческое бальное платье XVIII века" />
          </div>
          <div class="form-row">
            <div class="form-group">
              <label>Цена аренды (₽)</label>
              <input type="number" id="newPrice" name="price" required placeholder="3000" min="0" />
            </div>
            <div class="form-group">
              <label>Категория</label>
              <select id="newCategory" name="category" required>
                <option value="ball">Бальные платья XVIII-XIX век</option>
                <option value="vintage">Винтажные и свадебные платья</option>
                <option value="fashion">Фэшн и Будуар</option>
                <option value="medieval">Средневековые и Сказочные платья</option>
                <option value="ethnic-costumes">Этнические Костюмы</option>
                <option value="kimono">Японские кимоно женские</option>
                <option value="riding">Костюмы для Верховой езды</option>
                <option value="mens">Мужской Гардероб</option>
                <option value="cloaks">Плащи и Накидки</option>
                <option value="ethnic">Этнические украшения</option>
                <option value="accessories">Аксессуары</option>
                <option value="gloves-fans">Перчатки и веера</option>
                <option value="belt-shoes">Пояса и Обувь</option>
                <option value="furs">Мех</option>
                <option value="headwear">Головные Уборы</option>
                <option value="kids">Детские Костюмы</option>
              </select>
            </div>
          </div>
          <div class="form-group">
            <label>Описание</label>
            <textarea id="newDescription" name="description" rows="3" placeholder="Краткое описание товара..."></textarea>
          </div>

          <div class="form-group">
            <label>Фотографии товара (необязательно, можно выбрать сразу несколько)</label>
            <div id="newDropzone" class="upload-dropzone modal-dropzone">
              <div class="dropzone-prompt">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-bottom: 4px; color: #b39162;">
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                  <polyline points="17 8 12 3 7 8"></polyline>
                  <line x1="12" y1="3" x2="12" y2="15"></line>
                </svg>
                <p style="margin: 0; font-size: 0.9rem;">Перетащите фото сюда или нажмите для выбора</p>
                <span class="dropzone-subtext">Первое выбранное фото автоматически станет главным</span>
              </div>
              <input type="file" id="newFileInput" accept="image/*" multiple class="dropzone-file-input" />
            </div>
            <div id="newFilesPreview" class="new-files-preview"></div>
          </div>
          
          <div class="admin-modal-actions">
            <button type="button" id="cancelModalBtn" class="btn-secondary">Отмена</button>
            <button type="submit" id="createProductSubmitBtn" class="btn-primary">Создать товар</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <style>
    .admin-container {
      max-width: 1400px;
      margin: 0 auto;
      padding: 40px 20px;
      min-height: 100vh;
      color: #333;
    }
    .admin-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 30px;
      border-bottom: 2px solid #e0d5c5;
      padding-bottom: 20px;
    }
    .admin-header h1 {
      font-family: 'Playfair Display', serif;
      font-size: 2.5rem;
      color: #2e4634;
      margin: 0;
    }
    .admin-auth-badge {
      background: #e0d5c5;
      color: #2e4634;
      padding: 6px 12px;
      border-radius: 4px;
      font-weight: bold;
      font-size: 0.8rem;
    }
    .admin-grid {
      display: grid;
      grid-template-columns: 350px 1fr;
      gap: 30px;
      align-items: start;
    }
    
    /* Sidebar */
    .admin-sidebar {
      background: #fff;
      border-radius: 12px;
      box-shadow: 0 4px 20px rgba(0,0,0,0.05);
      border: 1px solid #e0d5c5;
      overflow: hidden;
      max-height: 80vh;
      display: flex;
      flex-direction: column;
    }
    .search-box {
      padding: 15px;
      background: #fdfaf6;
      border-bottom: 1px solid #e0d5c5;
    }
    .search-box input {
      width: 100%;
      padding: 10px;
      border: 1px solid #ccc;
      border-radius: 6px;
    }
    .product-list {
      overflow-y: auto;
      flex: 1;
    }
    .product-item {
      display: flex;
      flex-direction: column;
      width: 100%;
      padding: 12px 15px;
      text-align: left;
      border: none;
      background: none;
      border-bottom: 1px solid #f0efeb;
      cursor: pointer;
      transition: all 0.2s;
      gap: 5px;
    }
    .product-item:hover {
      background: #fdfaf6;
    }
    .product-item.active {
      background: #2e4634;
      color: #fff;
    }
    .p-info { display: flex; align-items: center; width: 100%; }
    .p-id {
      font-weight: bold;
      margin-right: 10px;
      opacity: 0.6;
      min-width: 40px;
    }
    .p-title {
      font-size: 0.9rem;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      flex: 1;
    }
    .p-cat-tag {
      font-size: 0.7rem;
      background: #e0d5c5;
      color: #2e4634;
      padding: 2px 6px;
      border-radius: 4px;
      align-self: flex-start;
      max-width: 100%;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .product-item.active .p-cat-tag {
      background: rgba(255,255,255,0.2);
      color: #fff;
    }
    
    .search-box {
      padding: 15px;
      background: #fdfaf6;
      border-bottom: 1px solid #e0d5c5;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }
    
    /* Main Area */
    .admin-main {
      background: #fff;
      border-radius: 12px;
      box-shadow: 0 4px 20px rgba(0,0,0,0.05);
      border: 1px solid #e0d5c5;
      padding: 30px;
    }
    .empty-state {
      text-align: center;
      padding: 100px 0;
      color: #777;
      font-style: italic;
    }
    .hidden { display: none; }
    
    .editor-section {
      margin-bottom: 40px;
      animation: fadeIn 0.3s ease;
    }
    .editor-section h2 {
      font-family: 'Playfair Display', serif;
      color: #2e4634;
      border-left: 4px solid #b39162;
      padding-left: 15px;
      margin-bottom: 25px;
    }
    
    .form-group { margin-bottom: 20px; }
    .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
    label { display: block; font-weight: bold; margin-bottom: 8px; color: #555; font-size: 0.9rem; }
    input, select, textarea {
      width: 100%;
      padding: 12px;
      border: 1px solid #ddd;
      border-radius: 6px;
      font-family: inherit;
    }
    
    .details-editor {
      background: #f9f7f4;
      padding: 15px;
      border-radius: 8px;
      margin-bottom: 10px;
    }
    .detail-row {
      display: grid;
      grid-template-columns: 1fr 1fr 40px;
      gap: 10px;
      margin-bottom: 10px;
    }
    .btn-remove {
      background: #ff4444;
      color: #fff;
      border: none;
      border-radius: 4px;
      cursor: pointer;
    }
    
    .btn-primary {
      background: #2e4634;
      color: #fff;
      border: none;
      padding: 12px 24px;
      border-radius: 6px;
      font-weight: bold;
      cursor: pointer;
      transition: background 0.2s;
    }
    .btn-primary:hover { background: #1f3023; }
    .btn-success { background: #28a745 !important; }
    .btn-success:hover { background: #218838 !important; }
    .btn-danger {
      background: #ff4444;
      color: #fff;
      border: none;
      padding: 12px 24px;
      border-radius: 6px;
      font-weight: bold;
      cursor: pointer;
      transition: background 0.2s;
      margin-left: auto;
    }
    .btn-danger:hover { background: #cc0000; }
    .form-actions { display: flex; gap: 10px; align-items: center; margin-top: 30px; }
    .btn-secondary {
      background: none;
      border: 1px dashed #2e4634;
      color: #2e4634;
      padding: 8px 16px;
      border-radius: 6px;
      cursor: pointer;
    }
    
    /* Gallery */
    .admin-gallery-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
      gap: 15px;
      margin-bottom: 30px;
    }
    .gallery-item {
      position: relative;
      aspect-ratio: 1;
      border-radius: 8px;
      overflow: hidden;
      border: 1px solid #ddd;
    }
    .gallery-item img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .img-del-btn {
      position: absolute;
      top: 5px;
      right: 5px;
      background: rgba(255,0,0,0.8);
      color: #fff;
      border: none;
      width: 24px;
      height: 24px;
      border-radius: 12px;
      cursor: pointer;
      font-weight: bold;
      z-index: 2;
    }
    .img-main-btn {
      position: absolute;
      top: 5px;
      left: 5px;
      background: rgba(255,255,255,0.9);
      color: #b39162;
      border: none;
      width: 24px;
      height: 24px;
      border-radius: 12px;
      cursor: pointer;
      font-weight: bold;
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 2;
      transition: all 0.2s;
    }
    .img-main-btn:hover { background: #b39162; color: #fff; }
    .gallery-item.is-main { border: 3px solid #b39162; }
    .main-badge {
      position: absolute;
      bottom: 5px;
      left: 5px;
      background: #b39162;
      color: #fff;
      font-size: 0.6rem;
      padding: 2px 6px;
      border-radius: 4px;
      font-weight: bold;
      z-index: 2;
    }
    
    .gallery-hint {
      font-size: 0.85rem;
      color: #666;
      margin-top: -10px;
      margin-bottom: 15px;
      font-style: italic;
    }
    .gallery-item[draggable="true"] {
      cursor: grab;
      user-select: none;
    }
    .gallery-item:active {
      cursor: grabbing;
    }
    .gallery-item.dragging {
      opacity: 0.35;
      transform: scale(0.92);
      border: 2px dashed #b39162;
    }
    .gallery-item.drag-over {
      outline: 3px solid #2e4634;
      outline-offset: 2px;
      box-shadow: 0 4px 15px rgba(0,0,0,0.15);
    }
    
    .details-actions-row {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
      margin-bottom: 20px;
    }

    .upload-dropzone {
      border: 2px dashed #c4b59d;
      border-radius: 8px;
      padding: 24px 16px;
      text-align: center;
      cursor: pointer;
      background: #faf8f5;
      transition: all 0.2s ease;
      position: relative;
    }
    .upload-dropzone:hover,
    .upload-dropzone.drag-active {
      border-color: #2e4634;
      background: #f0ede6;
    }
    .modal-dropzone {
      padding: 16px;
    }
    .dropzone-prompt {
      pointer-events: none;
    }
    .dropzone-subtext {
      display: block;
      font-size: 0.8rem;
      color: #777;
      margin-top: 4px;
    }
    .dropzone-file-input {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      opacity: 0;
      cursor: pointer;
    }

    .upload-progress {
      margin-top: 12px;
    }
    .progress-bar-wrapper {
      width: 100%;
      height: 8px;
      background: #e0d5c5;
      border-radius: 4px;
      overflow: hidden;
      margin-bottom: 6px;
    }
    .progress-bar-fill {
      height: 100%;
      width: 0%;
      background: #2e4634;
      transition: width 0.3s ease;
    }

    .new-files-preview {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-top: 10px;
    }
    .new-file-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 4px 8px;
      background: #f0ede6;
      border-radius: 4px;
      font-size: 0.8rem;
      border: 1px solid #d4c8b8;
      max-width: 100%;
    }
    .new-file-badge .btn-remove-file,
    .new-file-badge .btn-file-remove {
      background: none;
      border: none;
      font-weight: bold;
      cursor: pointer;
      color: #777;
      font-size: 1.1rem;
      line-height: 1;
      padding: 0;
    }
    .new-file-badge .btn-remove-file:hover,
    .new-file-badge .btn-file-remove:hover {
      color: #ff4444;
    }
    
    .tabs { display: flex; gap: 10px; margin-bottom: 15px; border-bottom: 1px solid #ddd; }
    .tab-btn { background: none; border: none; padding: 10px 20px; cursor: pointer; opacity: 0.6; }
    .tab-btn.active { opacity: 1; font-weight: bold; border-bottom: 2px solid #b39162; }
    .tab-content { display: none; }
    .tab-content.active { display: block; }
    .input-group { display: flex; gap: 10px; }

    /* Modal styles */
    .admin-modal {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(0, 0, 0, 0.6);
      backdrop-filter: blur(4px);
      z-index: 3000;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all 0.3s ease;
    }
    .admin-modal.hidden {
      display: none !important;
      opacity: 0;
      pointer-events: none;
    }
    .admin-modal-content {
      background: #fff;
      border-radius: 12px;
      border: 1px solid #e0d5c5;
      box-shadow: 0 10px 40px rgba(0,0,0,0.15);
      width: 90%;
      max-width: 600px;
      padding: 30px;
      position: relative;
      animation: modalSlideIn 0.3s ease;
    }
    .admin-modal-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 20px;
      border-bottom: 1px solid #e0d5c5;
      padding-bottom: 15px;
    }
    .admin-modal-header h2 {
      font-family: 'Playfair Display', serif;
      color: #2e4634;
      margin: 0;
      font-size: 1.8rem;
    }
    .btn-close {
      background: none;
      border: none;
      font-size: 2rem;
      cursor: pointer;
      color: #777;
      line-height: 1;
      padding: 0;
    }
    .btn-close:hover {
      color: #ff4444;
    }
    .admin-modal-actions {
      display: flex;
      gap: 15px;
      justify-content: flex-end;
      margin-top: 25px;
      border-top: 1px solid #e0d5c5;
      padding-top: 20px;
    }
    
    @keyframes modalSlideIn {
      from { transform: translateY(-20px); opacity: 0; }
      to { transform: translateY(0); opacity: 1; }
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(10px); }
      to { opacity: 1; transform: translateY(0); }
    }
  </style>

  <script is:inline>
    // Клиентская логика админки
    let products = [];
    let currentProductId = null;
    let pendingNewFiles = [];
    let draggedImageIndex = null;

    const categoryPresets = {
      'dresses': [
        { key: 'Размер', value: '42-46 (корсет)' },
        { key: 'Цвет', value: 'Изумрудный' },
        { key: 'Материал', value: 'Бархат, кружево' },
        { key: 'Комплектация', value: 'Платье, кринолин' },
        { key: 'Эпоха / Стиль', value: 'Викторианский стиль' }
      ],
      'suits': [
        { key: 'Размер', value: '48-52' },
        { key: 'Цвет', value: 'Черный' },
        { key: 'Материал', value: 'Шерсть, атлас' },
        { key: 'Комплектация', value: 'Сюртук, жилет, брюки' },
        { key: 'Эпоха / Стиль', value: 'Стимпанк / Викторианский' }
      ],
      'accessories': [
        { key: 'Материал', value: 'Металл, стекло' },
        { key: 'Цвет', value: 'Бронза / Золото' },
        { key: 'Стиль', value: 'Винтаж' }
      ]
    };

    function updateNewFilesPreview() {
      const preview = document.getElementById('newFilesPreview');
      if (!preview) return;
      preview.innerHTML = '';
      pendingNewFiles.forEach((file, idx) => {
        const badge = document.createElement('div');
        badge.className = 'new-file-badge';
        
        const titleSpan = document.createElement('span');
        titleSpan.textContent = `📷 ${file.name} (${Math.round(file.size / 1024)} KB)`;
        badge.appendChild(titleSpan);

        const removeBtn = document.createElement('button');
        removeBtn.type = 'button';
        removeBtn.className = 'btn-remove-file';
        removeBtn.title = 'Удалить';
        removeBtn.textContent = '×';
        removeBtn.onclick = () => {
          pendingNewFiles.splice(idx, 1);
          updateNewFilesPreview();
        };
        badge.appendChild(removeBtn);
        preview.appendChild(badge);
      });
    }

    async function loadData() {
      try {
        const response = await fetch('/data/products.json?v=' + Date.now());
        if (response.ok) {
          products = await response.json();
        }
      } catch (err) {
        console.error('Не удалось загрузить products.json:', err);
      }
    }

    function init() {
      const searchInput = document.getElementById('productSearch');
      const categoryFilter = document.getElementById('categoryFilter');
      const productItems = document.querySelectorAll('.product-item');
      
      function filterProducts() {
        const query = searchInput.value.toLowerCase();
        const category = categoryFilter.value;
        
        productItems.forEach(item => {
          const titleMatch = item.dataset.title.includes(query) || item.dataset.id.includes(query);
          const categoryMatch = category === 'all' || item.dataset.category === category;
          
          item.style.display = (titleMatch && categoryMatch) ? 'flex' : 'none';
        });
      }

      searchInput.addEventListener('input', filterProducts);
      categoryFilter.addEventListener('change', filterProducts);

      productItems.forEach(item => {
        item.addEventListener('click', () => {
          selectProduct(parseInt(item.dataset.id));
        });
      });
      
      // Auto-open product from URL
      const urlParams = new URLSearchParams(window.location.search);
      const urlId = urlParams.get('id');
      if (urlId) {
        selectProduct(parseInt(urlId), { scroll: true });
      }
      
      const infoForm = document.getElementById('infoForm');
      if (infoForm) infoForm.addEventListener('submit', saveInfo);

      const addDetailBtn = document.getElementById('addDetailBtn');
      if (addDetailBtn) addDetailBtn.addEventListener('click', () => addDetailRow('', ''));
      
      const fillPresetBtn = document.getElementById('fillPresetBtn');
      if (fillPresetBtn) {
        fillPresetBtn.addEventListener('click', fillCategoryPresets);
      }

      const addUrlBtn = document.getElementById('addUrlBtn');
      if (addUrlBtn) addUrlBtn.addEventListener('click', addImageUrl);

      const uploadBtn = document.getElementById('uploadBtn');
      if (uploadBtn) {
        uploadBtn.addEventListener('click', () => {
          const fileInput = document.getElementById('fileInput');
          if (fileInput && fileInput.files.length > 0) {
            uploadMultipleFiles(fileInput.files, currentProductId);
          }
        });
      }

      const deleteProductBtn = document.getElementById('deleteProductBtn');
      if (deleteProductBtn) deleteProductBtn.addEventListener('click', deleteEntireProduct);

      // Drag & Drop for gallery dropzone
      const uploadDropzone = document.getElementById('uploadDropzone');
      const fileInput = document.getElementById('fileInput');
      if (uploadDropzone && fileInput) {
        ['dragenter', 'dragover'].forEach(eventName => {
          uploadDropzone.addEventListener(eventName, (e) => {
            e.preventDefault();
            e.stopPropagation();
            uploadDropzone.classList.add('dragover');
          });
        });
        ['dragleave', 'drop'].forEach(eventName => {
          uploadDropzone.addEventListener(eventName, (e) => {
            e.preventDefault();
            e.stopPropagation();
            uploadDropzone.classList.remove('dragover');
          });
        });
        uploadDropzone.addEventListener('drop', (e) => {
          const dt = e.dataTransfer;
          if (dt && dt.files && dt.files.length > 0) {
            uploadMultipleFiles(dt.files, currentProductId);
          }
        });
        fileInput.addEventListener('change', () => {
          if (fileInput.files && fileInput.files.length > 0) {
            uploadMultipleFiles(fileInput.files, currentProductId);
          }
        });
      }

      // Drag & Drop for new product modal dropzone
      const newDropzone = document.getElementById('newDropzone');
      const newFileInput = document.getElementById('newFileInput');
      if (newDropzone && newFileInput) {
        ['dragenter', 'dragover'].forEach(eventName => {
          newDropzone.addEventListener(eventName, (e) => {
            e.preventDefault();
            e.stopPropagation();
            newDropzone.classList.add('dragover');
          });
        });
        ['dragleave', 'drop'].forEach(eventName => {
          newDropzone.addEventListener(eventName, (e) => {
            e.preventDefault();
            e.stopPropagation();
            newDropzone.classList.remove('dragover');
          });
        });
        newDropzone.addEventListener('drop', (e) => {
          const dt = e.dataTransfer;
          if (dt && dt.files && dt.files.length > 0) {
            Array.from(dt.files).forEach(f => {
              if (f.type.startsWith('image/')) pendingNewFiles.push(f);
            });
            updateNewFilesPreview();
          }
        });
        newFileInput.addEventListener('change', () => {
          if (newFileInput.files && newFileInput.files.length > 0) {
            Array.from(newFileInput.files).forEach(f => {
              if (f.type.startsWith('image/')) pendingNewFiles.push(f);
            });
            updateNewFilesPreview();
            newFileInput.value = '';
          }
        });
      }
      
      // Modal listeners
      const addModal = document.getElementById('addProductModal');
      const openAddModalBtn = document.getElementById('openAddModalBtn');
      if (openAddModalBtn && addModal) {
        openAddModalBtn.addEventListener('click', () => {
          pendingNewFiles = [];
          updateNewFilesPreview();
          addModal.classList.remove('hidden');
        });
      }

      const closeModalBtn = document.getElementById('closeModalBtn');
      if (closeModalBtn && addModal) {
        closeModalBtn.addEventListener('click', () => {
          pendingNewFiles = [];
          updateNewFilesPreview();
          addModal.classList.add('hidden');
        });
      }

      const cancelModalBtn = document.getElementById('cancelModalBtn');
      if (cancelModalBtn && addModal) {
        cancelModalBtn.addEventListener('click', () => {
          pendingNewFiles = [];
          updateNewFilesPreview();
          addModal.classList.add('hidden');
        });
      }

      if (addModal) {
        addModal.addEventListener('click', (e) => {
          if (e.target === addModal) {
            pendingNewFiles = [];
            updateNewFilesPreview();
            addModal.classList.add('hidden');
          }
        });
      }

      const addProductForm = document.getElementById('addProductForm');
      if (addProductForm) {
        addProductForm.addEventListener('submit', createProduct);
      }

      // Табы
      const tabBtns = document.querySelectorAll('.tab-btn');
      tabBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          tabBtns.forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));
          document.getElementById(btn.dataset.tab + 'Tab').classList.add('active');
        });
      });
    }

    function selectProduct(id, options = {}) {
      currentProductId = id;
      const product = products.find(p => p.id === id);
      if (!product) return;

      // Update URL
      const url = new URL(window.location);
      url.searchParams.set('id', id);
      window.history.replaceState({}, '', url);

      // Sidebar highlighting
      const items = document.querySelectorAll('.product-item');
      items.forEach(i => i.classList.remove('active'));
      
      const activeItem = document.querySelector(`.product-item[data-id="${id}"]`);
      if (activeItem) {
        activeItem.classList.add('active');
        if (options.scroll) {
            activeItem.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
      }

      document.getElementById('noSelection').classList.add('hidden');
      document.getElementById('editor').classList.remove('hidden');

      // Populate Info
      document.getElementById('editProductId').value = product.id;
      document.getElementById('editTitle').value = product.title;
      document.getElementById('editPrice').value = product.price;
      document.getElementById('editCategory').value = product.category;
      document.getElementById('editDescription').value = product.description || '';

      // Details
      const detailsContainer = document.getElementById('detailsContainer');
      detailsContainer.innerHTML = '';
      if (product.details) {
        Object.entries(product.details).forEach(([key, value]) => {
          addDetailRow(key, value);
        });
      }

      // Gallery
      renderGallery(product.images || []);
    }

    function fillCategoryPresets() {
      const category = document.getElementById('editCategory').value;
      const presets = categoryPresets[category] || categoryPresets['dresses'];
      const container = document.getElementById('detailsContainer');
      
      const existingKeys = new Set(
        Array.from(container.querySelectorAll('.detail-key')).map(input => input.value.trim().toLowerCase())
      );

      let added = 0;
      presets.forEach(p => {
        if (!existingKeys.has(p.key.toLowerCase())) {
          addDetailRow(p.key, p.value);
          added++;
        }
      });

      if (added === 0) {
        addDetailRow('', '');
      }
    }

    function addDetailRow(key, value) {
      const container = document.getElementById('detailsContainer');
      const row = document.createElement('div');
      row.className = 'detail-row';

      // Безопасное создание через DOM API — без innerHTML с интерполяцией (XSS-защита)
      const keyInput = document.createElement('input');
      keyInput.type = 'text';
      keyInput.className = 'detail-key';
      keyInput.placeholder = 'Ключ (например, Размер)';
      keyInput.setAttribute('list', 'detailsKeyPresets');
      keyInput.value = key || '';

      const valInput = document.createElement('input');
      valInput.type = 'text';
      valInput.className = 'detail-val';
      valInput.placeholder = 'Значение';
      valInput.value = value || '';

      const removeBtn = document.createElement('button');
      removeBtn.type = 'button';
      removeBtn.className = 'btn-remove';
      removeBtn.textContent = '×';
      removeBtn.onclick = () => row.remove();

      row.appendChild(keyInput);
      row.appendChild(valInput);
      row.appendChild(removeBtn);
      container.appendChild(row);
    }

    function renderGallery(images = []) {
      const grid = document.getElementById('galleryGrid');
      if (!grid) return;
      grid.innerHTML = '';
      if (!Array.isArray(images) || images.length === 0) return;
      images.forEach((img, index) => {
        const isMain = index === 0;
        const item = document.createElement('div');
        item.className = 'gallery-item' + (isMain ? ' is-main' : '');
        item.draggable = true;
        item.dataset.index = index;

        // Оптимизированное превью в сетке админки
        const thumbUrl = img.includes('cloudinary.com') && !img.includes('/w_')
          ? img.replace('/upload/', '/upload/w_300,f_auto,q_auto/')
          : img;

        const imgEl = document.createElement('img');
        imgEl.setAttribute('src', thumbUrl);
        imgEl.alt = '';
        item.appendChild(imgEl);

        if (!isMain) {
          const mainBtn = document.createElement('button');
          mainBtn.className = 'img-main-btn';
          mainBtn.title = 'Сделать главным';
          mainBtn.textContent = '★';
          mainBtn.onclick = (e) => {
            e.stopPropagation();
            setMainImage(img);
          };
          item.appendChild(mainBtn);
        } else {
          const badge = document.createElement('span');
          badge.className = 'main-badge';
          badge.textContent = 'ГЛАВНОЕ';
          item.appendChild(badge);
        }

        const delBtn = document.createElement('button');
        delBtn.className = 'img-del-btn';
        delBtn.title = 'Удалить';
        delBtn.textContent = '×';
        delBtn.onclick = (e) => {
          e.stopPropagation();
          deleteImage(img);
        };
        item.appendChild(delBtn);

        // Drag & Drop сортировка фото
        item.addEventListener('dragstart', (e) => {
          draggedImageIndex = index;
          item.classList.add('dragging');
          e.dataTransfer.effectAllowed = 'move';
          e.dataTransfer.setData('text/plain', String(index));
        });

        item.addEventListener('dragend', () => {
          item.classList.remove('dragging');
          document.querySelectorAll('.gallery-item').forEach(el => el.classList.remove('drag-over'));
        });

        item.addEventListener('dragover', (e) => {
          e.preventDefault();
          e.dataTransfer.dropEffect = 'move';
          item.classList.add('drag-over');
        });

        item.addEventListener('dragleave', () => {
          item.classList.remove('drag-over');
        });

        item.addEventListener('drop', (e) => {
          e.preventDefault();
          item.classList.remove('drag-over');
          const targetIndex = index;
          if (draggedImageIndex !== null && draggedImageIndex !== targetIndex) {
            reorderGallery(draggedImageIndex, targetIndex);
          }
        });

        grid.appendChild(item);
      });
    }

    async function reorderGallery(fromIdx, toIdx) {
      const product = products.find(p => p.id === currentProductId);
      if (!product || !product.images) return;

      const newImages = [...product.images];
      const [movedImg] = newImages.splice(fromIdx, 1);
      newImages.splice(toIdx, 0, movedImg);

      // Локальное оптимистичное обновление
      product.images = newImages;
      renderGallery(newImages);

      try {
        const res = await fetch('/api/admin/products', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            action: 'updateInfo',
            productId: currentProductId,
            metadata: { images: newImages }
          })
        });
        const result = await res.json();
        if (result.success) {
          await loadData();
          // Обновляем превью в сайдбаре, если сменилось первое фото
          const sidebarItem = document.querySelector(`.product-item[data-id="${currentProductId}"]`);
          if (sidebarItem && newImages[0]) {
            const sideImg = sidebarItem.querySelector('img');
            if (sideImg) sideImg.src = newImages[0];
          }
        } else {
          alert('Ошибка при изменении порядка: ' + result.error);
          await loadData();
          selectProduct(currentProductId);
        }
      } catch (err) {
        alert('Ошибка сети: ' + err.message);
        await loadData();
        selectProduct(currentProductId);
      }
    }

    async function saveInfo(e) {
      e.preventDefault();
      const saveBtn = e.submitter;
      const originalBtnText = saveBtn.textContent;
      
      const details = {};
      document.querySelectorAll('.detail-row').forEach(row => {
        const key = row.querySelector('.detail-key').value.trim();
        const val = row.querySelector('.detail-val').value.trim();
        if (key) details[key] = val;
      });

      const metadata = {
        title: document.getElementById('editTitle').value,
        price: parseInt(document.getElementById('editPrice').value) || 0,
        category: document.getElementById('editCategory').value,
        description: document.getElementById('editDescription').value,
        details: details
      };

      const payload = {
        action: 'updateInfo',
        productId: currentProductId,
        metadata: metadata
      };

      try {
        saveBtn.disabled = true;
        saveBtn.textContent = 'Сохранение...';
        
        const res = await fetch('/api/admin/products', { 
          method: 'POST', 
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload) 
        });
        const result = await res.json();
        
        if (result.success) {
          // Индикация успеха
          saveBtn.textContent = 'Сохранено! ✓';
          saveBtn.classList.add('btn-success');
          
          await loadData();
          
          // Обновляем элемент в сайдбаре
          const sidebarItem = document.querySelector(`.product-item[data-id="${currentProductId}"]`);
          if (sidebarItem) {
            sidebarItem.dataset.title = metadata.title.toLowerCase();
            sidebarItem.dataset.category = metadata.category;
            sidebarItem.querySelector('.p-title').textContent = metadata.title;
            sidebarItem.querySelector('.p-cat-tag').textContent = metadata.category;
          }
          
          // Перевыбираем товар, чтобы обновить все поля (включая возможные серверные изменения)
          selectProduct(currentProductId);
          
          setTimeout(() => {
            saveBtn.textContent = originalBtnText;
            saveBtn.classList.remove('btn-success');
            saveBtn.disabled = false;
          }, 2000);
          
        } else {
          alert('Ошибка: ' + result.error);
          saveBtn.textContent = originalBtnText;
          saveBtn.disabled = false;
        }
      } catch (e) {
        alert('Ошибка сети: ' + e.message);
        saveBtn.textContent = originalBtnText;
        saveBtn.disabled = false;
      }
    }

    function readFileAsBase64(file) {
      return new Promise((resolve, reject) => {
        const reader = new FileReader();
        reader.onload = () => resolve(reader.result);
        reader.onerror = () => reject(new Error('Не удалось прочитать файл ' + file.name));
        reader.readAsDataURL(file);
      });
    }

    async function uploadMultipleFiles(fileList, productId) {
      if (!productId) {
        alert('Пожалуйста, выберите товар перед загрузкой изображений.');
        return;
      }
      const files = Array.from(fileList).filter(f => f.type.startsWith('image/'));
      if (files.length === 0) return;

      // Предотвращение случайного закрытия вкладки при передаче тяжелых оригиналов
      const onBeforeUnload = (e) => {
        e.preventDefault();
        e.returnValue = 'Идёт загрузка фотографий. Пожалуйста, не закрывайте вкладку.';
        return e.returnValue;
      };
      window.addEventListener('beforeunload', onBeforeUnload);

      const progressContainer = document.getElementById('uploadProgress');
      const progressBar = document.getElementById('uploadProgressBar');
      const progressText = document.getElementById('uploadProgressText');
      const uploadBtn = document.getElementById('uploadBtn');

      if (progressContainer) progressContainer.classList.remove('hidden');
      if (progressBar) progressBar.style.width = '0%';
      if (progressText) progressText.textContent = `Подготовка 0/${files.length}...`;
      if (uploadBtn) uploadBtn.disabled = true;

      let successCount = 0;
      let failedFiles = [];

      for (let i = 0; i < files.length; i++) {
        const file = files[i];
        const fileSizeMB = (file.size / (1024 * 1024)).toFixed(1);
        const pct = Math.round(((i) / files.length) * 100);
        if (progressBar) progressBar.style.width = pct + '%';
        if (progressText) progressText.textContent = `Загрузка ${i + 1} из ${files.length} (${file.name}, ${fileSizeMB} МБ без потери качества)...`;

        let uploaded = false;
        // До 2 попыток на каждый файл в случае временных сетевых задержек
        for (let attempt = 1; attempt <= 2 && !uploaded; attempt++) {
          try {
            if (attempt > 1 && progressText) {
              progressText.textContent = `Повторная попытка для ${file.name}...`;
            }
            const base64 = await readFileAsBase64(file);
            const payload = {
              action: 'addImage',
              productId: productId,
              source: 'base64',
              file: base64
            };

            const res = await fetch('/api/admin/products', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(payload)
            });
            const result = await res.json();
            if (result.success) {
              uploaded = true;
              successCount++;
            } else {
              console.error(`Ошибка загрузки ${file.name} (попытка ${attempt}):`, result.error);
            }
          } catch (err) {
            console.error(`Сетевая ошибка при загрузке ${file.name} (попытка ${attempt}):`, err);
          }
        }

        if (!uploaded) {
          failedFiles.push(file.name);
        }
      }

      window.removeEventListener('beforeunload', onBeforeUnload);

      if (progressBar) progressBar.style.width = '100%';
      if (failedFiles.length === 0) {
        if (progressText) progressText.textContent = `Готово! Успешно загружено ${successCount} из ${files.length} фото в исходном качестве. ✓`;
      } else {
        if (progressText) progressText.textContent = `Загружено ${successCount} из ${files.length}. Не удалось: ${failedFiles.join(', ')}`;
      }
      if (uploadBtn) uploadBtn.disabled = false;

      const fileInput = document.getElementById('fileInput');
      if (fileInput) fileInput.value = '';

      await loadData();
      selectProduct(productId);

      setTimeout(() => {
        if (progressContainer) progressContainer.classList.add('hidden');
        if (progressBar) progressBar.style.width = '0%';
      }, 4000);
    }

    async function createProduct(e) {
      e.preventDefault();
      const submitBtn = document.getElementById('createProductSubmitBtn');
      const originalText = submitBtn.textContent;
      
      const payload = {
        action: 'createProduct',
        title: document.getElementById('newTitle').value.trim(),
        price: parseInt(document.getElementById('newPrice').value) || 0,
        category: document.getElementById('newCategory').value,
        description: document.getElementById('newDescription').value.trim(),
        details: {}
      };

      try {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Создание товара...';
        
        const res = await fetch('/api/admin/products', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        const result = await res.json();
        
        if (result.success && result.product) {
          const newId = result.product.id;

          // Если были выбраны фото сразу при создании товара — загружаем их по очереди
          if (pendingNewFiles.length > 0) {
            const onBeforeUnload = (e) => {
              e.preventDefault();
              e.returnValue = 'Идёт сохранение нового товара с фотографиями...';
              return e.returnValue;
            };
            window.addEventListener('beforeunload', onBeforeUnload);

            for (let i = 0; i < pendingNewFiles.length; i++) {
              submitBtn.textContent = `Загрузка фото (${i + 1}/${pendingNewFiles.length})...`;
              let uploaded = false;
              for (let attempt = 1; attempt <= 2 && !uploaded; attempt++) {
                try {
                  const base64 = await readFileAsBase64(pendingNewFiles[i]);
                  const uploadRes = await fetch('/api/admin/products', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                      action: 'addImage',
                      productId: newId,
                      source: 'base64',
                      file: base64
                    })
                  });
                  const uploadData = await uploadRes.json();
                  if (uploadData.success) uploaded = true;
                } catch (photoErr) {
                  console.error('Ошибка загрузки фото при создании (попытка ' + attempt + '):', photoErr);
                }
              }
            }
            window.removeEventListener('beforeunload', onBeforeUnload);
          }

          submitBtn.textContent = 'Успешно создано! ✓';
          submitBtn.classList.add('btn-success');
          pendingNewFiles = [];
          setTimeout(() => {
            window.location.href = '/admin?id=' + newId;
          }, 800);
        } else {
          alert('Ошибка при создании: ' + result.error);
          submitBtn.textContent = originalText;
          submitBtn.disabled = false;
        }
      } catch (err) {
        alert('Ошибка сети: ' + err.message);
        submitBtn.textContent = originalText;
        submitBtn.disabled = false;
      }
    }

    async function addImageUrl() {
      const url = document.getElementById('imgUrlInput').value.trim();
      if (!url) return;

      const payload = {
        action: 'addImage',
        productId: currentProductId,
        source: 'url',
        url: url
      };

      try {
        const res = await fetch('/api/admin/products', { 
          method: 'POST', 
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        const result = await res.json();
        if (result.success) {
          document.getElementById('imgUrlInput').value = '';
          await loadData();
          selectProduct(currentProductId);
        } else {
          alert('Ошибка: ' + result.error);
        }
      } catch (e) {
        alert('Ошибка при скачивании: ' + e.message);
      }
    }

    async function setMainImage(path) {
      const product = products.find(p => p.id === currentProductId);
      if (!product) return;

      // Reorder images: move selected path to index 0
      const newImages = [path, ...product.images.filter(img => img !== path)];
      
      const metadata = {
        images: newImages
      };

      const payload = {
        action: 'updateInfo',
        productId: currentProductId,
        metadata: metadata
      };

      try {
        const res = await fetch('/api/admin/products', { 
          method: 'POST', 
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        const result = await res.json();
        if (result.success) {
          await loadData();
          selectProduct(currentProductId);
        } else {
          alert('Ошибка: ' + result.error);
        }
      } catch (e) {
        alert('Ошибка сети: ' + e.message);
      }
    }

    async function deleteImage(path) {
      if (!confirm('Удалить это изображение? Оно будет стерто из базы и хранилища.')) return;

      try {
        const res = await fetch('/api/admin/products', {
          method: 'DELETE',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'deleteImage', productId: currentProductId, imagePath: path })
        });
        const result = await res.json();
        if (result.success) {
          await loadData();
          selectProduct(currentProductId);
        } else {
          alert('Ошибка: ' + result.error);
        }
      } catch (e) {
        alert('Ошибка при удалении: ' + e.message);
      }
    }

    async function deleteEntireProduct() {
      const product = products.find(p => p.id === currentProductId);
      if (!product) return;

      const confirmMsg = `ВНИМАНИЕ! Вы собираетесь полностью удалить товар "${product.title}" (ID: ${product.id}).\n\n` +
                        `Это действие удалит:\n` +
                        `- Все данные о товаре из базы\n` +
                        `- ВСЕ фотографии этого товара из облака/хранилища\n\n` +
                        `Это действие необратимо. Продолжить?`;

      if (!confirm(confirmMsg)) return;
      if (!confirm('Вы АБСОЛЮТНО уверены? Последний шанс отменить.')) return;

      try {
        const res = await fetch('/api/admin/products', {
          method: 'DELETE',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'deleteProduct', productId: currentProductId })
        });
        const result = await res.json();
        if (result.success) {
          alert('Товар и все его файлы успешно удалены.');
          window.location.reload(); // Reload to refresh the product list
        } else {
          alert('Ошибка: ' + result.error);
        }
      } catch (e) {
        alert('Ошибка при удалении товара: ' + e.message);
      }
    }

    loadData().then(init);
  </script>
</BaseLayout>
