---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

import products from '../data/products.json';

const previewIds = [301, 303, 201, 210, 401, 402];
const previewProducts = products.filter(p => previewIds.includes(p.id));

// Filter pool for randomization (Ball, Medieval, Vintage)
const eligibleCategories = ['ball', 'medieval', 'vintage'];
const allEligibleProducts = products
  .filter(p => eligibleCategories.includes(p.category))
  .map(p => ({
    id: p.id,
    title: p.title,
    price: p.price,
    images: p.images,
    description: p.description,
    details: p.details,
    slug: p.slug,
    category: p.category
  }));

const schemaJson = {
  "@context": "https://schema.org",
  "@type": "RentalBusiness",
  "name": "Прокат от Кет",
  "description": "Прокат роскошных викторианских, бальных и исторических платьев в Москве. Более 100 образов: платья XIX века, винтаж, кимоно, карнавальные костюмы для фотосессий и торжеств.",
  "url": "https://ketrent.ru/",
  "@id": "https://ketrent.ru/",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Шипиловская ул., 58, корпус 1",
    "addressLocality": "Москва",
    "postalCode": "115580",
    "addressCountry": "RU"
  },
  "areaServed": {
    "@type": "City",
    "name": "Москва"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 55.617329,
    "longitude": 37.744105
  },
  "openingHoursSpecification": {
    "@type": "OpeningHoursSpecification",
    "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"],
    "opens": "11:00",
    "closes": "22:00"
  },
  "makesOffer": [
    { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Аренда бальных платьев" } },
    { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Аренда викторианских платьев" } },
    { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Аренда кимоно" } },
    { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Аренда винтажных платьев" } },
    { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Аренда костюмов для фотосессий" } }
  ],
  "currenciesAccepted": "RUB",
  "paymentAccepted": "Наличные, Банковская карта",
  "sameAs": [
    "https://vk.com/im/convo/-60489675?entrypoint=community_page&tab=all",
    "https://t.me/prokat_ot_ket"
  ],
  "priceRange": "1500 ₽ — 15000 ₽"
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Сколько стоит прокат платья?",
      "acceptedAnswer": { "@type": "Answer", "text": "Цена проката зависит от модели и срока: от 1 500 до 15 000 ₽. Точную стоимость уточняйте у нас в Telegram или WhatsApp." }
    },
    {
      "@type": "Question",
      "name": "Как забронировать платье?",
      "acceptedAnswer": { "@type": "Answer", "text": "Напишите нам в Telegram (@prokat_ot_ket) или WhatsApp по ссылке в контактах. Мы обсудим варианты, подберём наряд и оформим бронь." }
    },
    {
      "@type": "Question",
      "name": "Есть ли примерка?",
      "acceptedAnswer": { "@type": "Answer", "text": "Да, примерка возможна по предварительной записи. Примерка платная. " }
    },
    {
      "@type": "Question",
      "name": "Делаете ли вы доставку?",
      "acceptedAnswer": { "@type": "Answer", "text": "Да, есть свой курьер, доставка осуществляется по Москве. " }
    },
    {
      "@type": "Question",
      "name": "Какие размеры есть в коллекции?",
      "acceptedAnswer": { "@type": "Answer", "text": "В нашей коллекции представлены размеры XS–XXL. Подробнее уточняйте по конкретным моделям. " }
    }
  ]
};
---

<BaseLayout
  title="Аренда платьев и костюмов от Кет в Москве | Прокат исторических и бальных образов"
  description="Прокат от Кет — профессиональная аренда платьев и костюмов в Москве. В нашей коллекции более 400 уникальных нарядов: викторианские, бальные, исторические и винтажные платья, кимоно и костюмы для фотосессий."
  keywords="аренда платьев, прокат платьев Москва, аренда костюмов, прокат костюмов, вечерние платья, исторические платья, викторианский стиль, бальное платье, платье 19 век, винтажные платья, кимоно, сари, косплей, конные амазонки, прокат от Кет"
  canonicalUrl="https://ketrent.ru/"
  ogTitle="Аренда платьев и костюмов от Кет в Москве"
  ogDescription="Более 400 уникальных образов для аренды: от Средневековья до XX века. Исторические платья, кимоно, костюмы для фотосессий от Проката от Кет. "
  twitterTitle="Аренда платьев и костюмов от Кет"
  twitterDescription="Прокат исторических и бальных платьев, винтажных нарядов, кимоно и костюмов в Москве. Идеально для фотосессий и торжеств."
  schemaJson={[schemaJson, faqSchema]}
  currentPage="home"
  preloadImage="/img/og-image.jpg"
>
  <Header currentPage="home" />

  <section class="hero">
    <div class="hero-overlay"></div>
    <div class="container hero-container">
      <h1 class="hero-title">
        Элегантность<br /><em>сквозь столетия</em>
      </h1>
      <p class="hero-subtitle">
        Аренда платьев и костюмов в Москве. <br />
        Прокат от Кет. <br />
        Уникальная коллекция вдохновленная эстетикой XII—XX веков: более 400 образов для ваших фотосессий и торжеств.
      </p>
      <div class="hero-actions">
        <a href="/catalog" class="btn btn-hero">Смотреть коллекцию</a>
      </div>
    </div>
  </section>

  <section id="about" class="section about">
    <div class="container">
      <h2 class="section-title">Наследие и Мастерство</h2>
      <div class="about-grid">
        <div class="about-text">
          <p>
            Наша философия проста: красота не должна быть архаичной. Мы
            берем лучшее из исторической моды — внимание к деталям,
            изысканные силуэты, роскошные ткани — и адаптируем это для комфортного ношения.
          </p>
          <p>
            Коллекция охватывает эпохи от XII до XX века и включает платья, сари, костюмы для верховой езды, конные амазонки, платья кринолины, кимоно, винтажные, мужские и женские образы.
            Каждое платье создается вручную, по профессиональным лекалам с учетом современной посадки. Это не просто одежда, это произведения
            искусства, рассказывающие истории элегантности и утонченности.
          </p>
        </div>
        <div class="about-decorative-box">
          <img
            src="/img/img1.jpg"
            alt="Процесс создания исторического платья"
            class="about-image"
            loading="lazy"
            decoding="async"
            width="600"
            height="800"
          />
        </div>
      </div>
    </div>
  </section>

  <section id="catalog-preview" class="section catalog-preview">
    <div class="container">
      <h2 class="section-title">Примеры образов</h2>
      <p class="section-desc">
        Малая часть нашей большой коллекции.
      </p>

      <div class="cards-grid">
        {previewProducts.map((product, i) => (
          <article class="card" data-preview-index={i}>
            <div class="card-image">
              <a href={`/product/${product.slug}`} class="image-seo-link" tabindex="-1" aria-hidden="true">
                <img
                  src={product.images[0]}
                  alt={product.title}
                  loading="lazy"
                  width="400"
                  height="500"
                />
              </a>
            </div>
            <div class="card-body">
              <h3 class="card-title">
                <a href={`/product/${product.slug}`} class="seo-link">{product.title}</a>
              </h3>
              <p class="card-price">{product.price != null ? product.price.toLocaleString('ru-RU') + ' ₽' : 'Нет данных'}</p>
              <div class="card-actions">
                <a href={`/product/${product.slug}`} class="btn-text">Подробнее &rarr;</a>
                <button class="btn-card-share" data-slug={product.slug} data-title={product.title} aria-label="Поделиться">
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
                    <path d="M13.5 1a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3M11 2.5a2.5 2.5 0 1 1 .603 1.628l-6.718 3.12a2.5 2.5 0 0 1 0 1.504l6.718 3.12a2.5 2.5 0 1 1-.488.876l-6.718-3.12a2.5 2.5 0 1 1 0-3.256l6.718-3.12A2.5 2.5 0 0 1 11 2.5m-8.5 4a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3m11 5.5a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3"/>
                  </svg>
                </button>
              </div>
            </div>
          </article>
        ))}
      </div>

      <div class="center-btn">
        <a href="/catalog" class="btn btn-outline">Открыть полный каталог</a>
      </div>
    </div>
  </section>

  <section id="faq" class="section faq-section">
    <div class="container">
      <h2 class="section-title">Частые вопросы</h2>
      <div class="faq-list">
        <details class="faq-item">
          <summary class="faq-question">Сколько стоит прокат платья?</summary>
          <div class="faq-answer">Цена проката зависит от модели и срока: от 1 500 до 15 000 ₽. Точную стоимость уточняйте у нас в Telegram или WhatsApp.</div>
        </details>
        <details class="faq-item">
          <summary class="faq-question">Как забронировать платье?</summary>
          <div class="faq-answer">Напишите нам в Telegram (@prokat_ot_ket) или WhatsApp по ссылке в контактах. Мы обсудим варианты, подберём наряд и оформим бронь.</div>
        </details>
        <details class="faq-item">
          <summary class="faq-question">Есть ли примерка?</summary>
          <div class="faq-answer">Примерка в студии проводится ежедневно с 11:00 до 22:00 по предварительной записи. Стоимость примерки (30 минут) — 500 ₽.</div>
        </details>
        <details class="faq-item">
          <summary class="faq-question">Делаете ли вы доставку?</summary>
          <div class="faq-answer">Да, есть свой курьер, доставка осуществляется по Москве (По предварительной договорённости).</div>
        </details>
        <details class="faq-item">
          <summary class="faq-question">Какие размеры есть в коллекции?</summary>
          <div class="faq-answer">В нашей коллекции представлены размеры 38-54 (XS–XXL). Подробнее уточняйте по конкретным моделям.</div>
        </details>
      </div>
    </div>
  </section>

  <Footer />

  <Fragment slot="scripts">
    <script is:inline define:vars={{ previewProducts, allEligibleProducts }}>
      window.__previewProducts = previewProducts;
      window.__allEligibleProducts = allEligibleProducts;
    </script>
    <script>
      import '../scripts/shared.js';
      import '../scripts/mobile-nav.js';
      import '../scripts/index-preview.js';
      import '../scripts/parallax.js';
    </script>
  </Fragment>
</BaseLayout>
