---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ProductCard from '../../components/ProductCard.astro';
import products from '../../data/products.json';

const categories = [
  { slug: 'all', label: 'Все' },
  { slug: 'furs', label: 'Мех' },
  { slug: 'vintage', label: 'Vintage и Свадебные' },
  { slug: 'ball', label: 'Бальные' },
  { slug: 'medieval', label: 'Средневековые и Сказочные' },
  { slug: 'fashion', label: 'Fashion и Будуар' },
  { slug: 'riding', label: 'Костюмы для верховой езды' },
  { slug: 'mens', label: 'Мужской Гардероб' },
  { slug: 'accessories', label: 'Аксессуары' },
  { slug: 'ethnic', label: 'Этнические украшения' },
  { slug: 'ethnic-costumes', label: 'Этнические костюмы' },
  { slug: 'headwear', label: 'Головные Уборы' },
  { slug: 'kimono', label: 'Японские Кимоно' },
  { slug: 'belt-shoes', label: 'Пояса и Обувь' },
  { slug: 'gloves-fans', label: 'Перчатки и Веера' },
  { slug: 'cloaks', label: 'Плащи и накидки' }
];

// Schema: BreadcrumbList
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Главная", "item": "https://ketrent.ru/" },
    { "@type": "ListItem", "position": 2, "name": "Каталог", "item": "https://ketrent.ru/catalog" }
  ]
};

// Schema: ItemList for all products
const itemListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "Каталог платьев — Прокат от Кет",
  "numberOfItems": products.length,
  "itemListElement": products.slice(0, 30).map((p: any, i: number) => ({
    "@type": "ListItem",
    "position": i + 1,
    "item": {
      "@type": "Product",
      "url": `https://ketrent.ru/product/${p.slug}`,
      "name": p.title,
      "description": p.description || '',
      "image": p.images?.[0] || '',
      "offers": {
        "@type": "Offer",
        "price": p.price,
        "priceCurrency": "RUB",
        "availability": "https://schema.org/InStock"
      }
    }
  }))
};

const combinedSchema = [breadcrumbSchema, itemListSchema];
---

<BaseLayout
  title="Аренда платьев и костюмов в Москве — Каталог | Прокат от Кет"
  description="Огромный выбор для аренды: более 400 исторических, бальных и винтажных нарядов. Прокат платьев и костюмов в Москве для фотосессий, балов и тематических вечеринок."
  keywords="аренда платьев, прокат платьев Москва, аренда костюмов, прокат костюмов, каталог платьев, вечерние платья, бальные платья, викторианские платья, винтажные платья, сари, кимоно, свадебные платья, косплей"
  canonicalUrl="https://ketrent.ru/catalog"
  ogTitle="Каталог аренды платьев и костюмов от Кет"
  ogDescription="Посмотрите наш ассортимент — более 400 образов для аренды в Москве. Исторические платья, кимоно, костюмы для съемок."
  schemaJson={combinedSchema}
  currentPage="catalog"
  preloadImage="/img/img18.jpg"
>

  <Header currentPage="catalog" />

  <section class="hero catalog-hero">
    <div class="hero-overlay"></div>
    <div class="container hero-container">
      <h1 class="hero-title">Аренда платьев и костюмов</h1>
      <p class="hero-subtitle">В нашей коллекции более 400 уникальных образов: от античности и средневековья до винтажа XX века. Найдите идеальный наряд для фотосессии или торжества в Москве.</p>
      <div class="catalog-filters" role="group" aria-label="Фильтры каталога">
        {categories.map(cat => (
          <button
            class={`filter-btn${cat.slug === 'all' ? ' active' : ''}`}
            data-filter={cat.slug}
            aria-pressed={cat.slug === 'all' ? 'true' : 'false'}
          >
            {cat.label}
          </button>
        ))}
      </div>
    </div>
  </section>

  <section class="section catalog-section">
    <div class="container">
      <h2 class="visually-hidden">Наш ассортимент</h2>
      <div class="catalog-grid" id="catalogGrid" role="list" aria-label="Каталог платьев">
        {products.map((product: any, index: number) => (
          <ProductCard
            title={product.title}
            price={product.price}
            image={product.images?.[0] || ''}
            category={product.category}
            index={index}
            id={product.id}
            slug={product.slug}
            description={product.description}
          />
        ))}
      </div>

      <!-- Кнопка "Показать еще" -->
      <div class="load-more-container" id="loadMoreContainer" style="display: none;">
        <button class="btn btn-outline" id="loadMoreBtn">Показать еще</button>
      </div>
    </div>
  </section>

  <Footer />

  <Fragment slot="scripts">
    <script is:inline>
      window.__catalogProducts = null;
    </script>
    <script>
      import '../../scripts/shared.js';
      import '../../scripts/mobile-nav.js';
      import '../../scripts/catalog-client.js';
    </script>
  </Fragment>
</BaseLayout>
