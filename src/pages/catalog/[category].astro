---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ProductCard from '../../components/ProductCard.astro';
import products from '../../data/products.json';

const categories = [
  { slug: 'furs', label: 'Мех' },
  { slug: 'vintage', label: 'Vintage и Свадебные' },
  { slug: 'ball', label: 'Бальные' },
  { slug: 'medieval', label: 'Средневековые и Сказочные' },
  { slug: 'fashion', label: 'Fashion и Будуар' },
  { slug: 'riding', label: 'Костюмы для верховой езды' },
  { slug: 'mens', label: 'Мужской Гардероб' },
  { slug: 'accessories', label: 'Аксессуары' },
  { slug: 'ethnic', label: 'Этнические украшения' },
  { slug: 'headwear', label: 'Головные Уборы' },
  { slug: 'kimono', label: 'Японские Кимоно' },
  { slug: 'belt-shoes', label: 'Пояса и Обувь' },
  { slug: 'gloves-fans', label: 'Перчатки и Веера' },
  { slug: 'cloaks', label: 'Плащи и накидки' }
];

export async function getStaticPaths() {
  const cats = [
      'furs', 'vintage', 'ball', 'medieval', 'fashion', 'riding', 'mens', 
      'accessories', 'ethnic', 'headwear', 'kimono', 'belt-shoes', 'gloves-fans', 'cloaks'
  ];
  return cats.map((category) => ({
    params: { category },
  }));
}

const { category } = Astro.params;
const categoryInfo = categories.find(c => c.slug === category);
const categoryLabel = categoryInfo ? categoryInfo.label : 'Каталог';

const categoryProducts = products.filter(p => p.category === category);

// Schema: BreadcrumbList
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Главная", "item": "https://ketrent.ru/" },
    { "@type": "ListItem", "position": 2, "name": "Каталог", "item": "https://ketrent.ru/catalog" },
    { "@type": "ListItem", "position": 3, "name": categoryLabel, "item": `https://ketrent.ru/catalog/${category}` }
  ]
};

// Schema: ItemList for category
const itemListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": `${categoryLabel} — Каталог Прокат от Кет`,
  "numberOfItems": categoryProducts.length,
  "itemListElement": categoryProducts.slice(0, 30).map((p: any, i: number) => ({
    "@type": "ListItem",
    "position": i + 1,
    "item": {
      "@type": "Product",
      "url": `https://ketrent.ru/product/${p.slug}`,
      "name": p.title,
      "description": p.description || '',
      "image": p.images?.[0] || '',
      "offers": {
        "@type": "Offer",
        "price": p.price,
        "priceCurrency": "RUB",
        "availability": "https://schema.org/InStock"
      }
    }
  }))
};

const combinedSchema = [breadcrumbSchema, itemListSchema];

// Чтобы модалка на странице категории тоже работала (она зависит от глобального индекса allCards),
// мы передадим в ProductCard правильный index из ИСХОДНОГО массива products, а не отфильтрованного.
// Но скрипт catalog-client жестко фильтрует карточки по dataset-category.
const categoryKeywords: Record<string, string> = {
  ball: 'бальные платья, вечерние платья, пышные платья, платья 19 век, кринолины',
  vintage: 'винтажные платья, свадебные платья, ретро платья, 70-е, 60-е',
  medieval: 'средневековые платья, сказочные образы, косплей, фэнтези костюмы',
  riding: 'костюмы для верховой езды, амазонки, конные прогулки, исторические костюмы',
  kimono: 'японские кимоно, юката, азиатские образы, восточные костюмы',
  ethnic: 'этнические украшения, сари, индийские украшения, бохо стиль',
  mens: 'мужской гардероб, фраки, сюртуки, мужские исторические костюмы'
};

const extraKeywords = categoryKeywords[category as string] || '';
const baseKeywords = 'прокат от Кет, аренда платьев Москва, аренда костюмов, прокат костюмов, исторические образы';
---

<BaseLayout
  title={`Аренда: ${categoryLabel} — Каталог платьев и костюмов | Прокат от Кет`}
  description={`Аренда и прокат в категории ${categoryLabel}. В нашей коллекции более 400 образов для фотосессий и мероприятий в Москве.`}
  keywords={extraKeywords ? `${extraKeywords}, ${baseKeywords}` : baseKeywords}
  canonicalUrl={`https://ketrent.ru/catalog/${category}`}
  schemaJson={combinedSchema}
  currentPage="catalog"
>
  <Header currentPage="catalog" />

  <section class="hero catalog-hero">
    <div class="hero-overlay"></div>
    <div class="container hero-container">
      <div class="breadcrumbs text-sm text-gray-300 mb-4 inline-block">
        <a href="/catalog" class="hover:text-white transition-colors">← Весь каталог</a>
      </div>
      <h1 class="hero-title">Аренда: {categoryLabel}</h1>
      <p class="hero-subtitle">В наличии {categoryProducts.length} вариантов</p>
    </div>
  </section>

  <section class="section catalog-section">
    <div class="container">
      <div class="catalog-grid" id="catalogGrid" role="list">
        {categoryProducts.map((product: any) => {
            // Find its real global index for the client side modal to work
            const realIndex = products.findIndex(p => p.id === product.id);
            return (
              <ProductCard
                title={product.title}
                price={product.price}
                image={product.images?.[0] || ''}
                category={product.category}
                index={realIndex}
                id={product.id}
                slug={product.slug}
                description={product.description}
              />
            )
        })}
      </div>
    </div>
  </section>

  <Footer />

  <Fragment slot="scripts">
    <script is:inline>
      window.__catalogProducts = null;
    </script>
    <script>
      import '../../scripts/shared.js';
      import '../../scripts/mobile-nav.js';
      
      // Мини-версия catalog-client только для категории (без фильтров)
      import { initCategoryPage } from '../../scripts/category-client.js';
      document.addEventListener('DOMContentLoaded', initCategoryPage);
    </script>
  </Fragment>
</BaseLayout>
