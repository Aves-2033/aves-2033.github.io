---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ProductCard from '../../components/ProductCard.astro';
import products from '../../data/products.json';

const categories = [
  { slug: 'ball', label: 'Бальные платья XVIII-XIX век' },
  { slug: 'vintage', label: 'Винтажные и свадебные платья' },
  { slug: 'medieval', label: 'Средневековые и Сказочные платья' },
  { slug: 'fashion', label: 'Фэшн и Будуар' },
  { slug: 'riding', label: 'Костюмы для Верховой езды' },
  { slug: 'mens', label: 'Мужской Гардероб' },
  { slug: 'accessories', label: 'Аксессуары' },
  { slug: 'ethnic', label: 'Этнические украшения' },
  { slug: 'ethnic-costumes', label: 'Этнические Костюмы' },
  { slug: 'headwear', label: 'Головные Уборы' },
  { slug: 'kimono', label: 'Японские кимоно женские' },
  { slug: 'belt-shoes', label: 'Пояса и Обувь' },
  { slug: 'gloves-fans', label: 'Перчатки и веера' },
  { slug: 'cloaks', label: 'Плащи и Накидки' },
  { slug: 'furs', label: 'Мех' },
];

export async function getStaticPaths() {
  const cats = [
      'furs', 'vintage', 'ball', 'medieval', 'fashion', 'riding', 'mens', 
      'accessories', 'ethnic', 'ethnic-costumes', 'headwear', 'kimono', 'belt-shoes', 'gloves-fans', 'cloaks'
  ];
  return cats.map((category) => ({
    params: { category },
  }));
}

const { category } = Astro.params;
const categoryInfo = categories.find(c => c.slug === category);
const categoryLabel = categoryInfo ? categoryInfo.label : 'Каталог';

const categoryProducts = products.filter(p => p.category === category);

// Schema: BreadcrumbList
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Главная", "item": "https://ketrent.ru/" },
    { "@type": "ListItem", "position": 2, "name": "Каталог", "item": "https://ketrent.ru/catalog" },
    { "@type": "ListItem", "position": 3, "name": categoryLabel, "item": `https://ketrent.ru/catalog/${category}` }
  ]
};

// Schema: ItemList for category
const itemListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": `${categoryLabel} — Каталог Прокат от Кет`,
  "numberOfItems": categoryProducts.length,
  "itemListElement": categoryProducts.slice(0, 30).map((p: any, i: number) => ({
    "@type": "ListItem",
    "position": i + 1,
    "item": {
      "@type": "Product",
      "url": `https://ketrent.ru/product/${p.slug}`,
      "name": p.title,
      "description": p.description || '',
      "image": p.images?.[0] || '',
      "offers": {
        "@type": "Offer",
        "price": p.price,
        "priceCurrency": "RUB",
        "availability": "https://schema.org/InStock"
      }
    }
  }))
};

const combinedSchema = [breadcrumbSchema, itemListSchema];

// Чтобы модалка на странице категории тоже работала (она зависит от глобального индекса allCards),
// мы передадим в ProductCard правильный index из ИСХОДНОГО массива products, а не отфильтрованного.
// Но скрипт catalog-client жестко фильтрует карточки по dataset-category.
const categorySEO: Record<string, { title: string; description: string; keywords: string }> = {
  ball: {
    title: 'Аренда бальных платьев XVIII-XIX век в Москве | Прокат от Кет',
    description: 'Прокат бальных платьев эпохи XVIII-XIX века в Москве. Кринолины, пышные юбки, корсеты. Идеально для фотосессий, балов и исторических мероприятий. От 1 500 ₽.',
    keywords: 'аренда бальных платьев Москва, прокат бального платья, платье 19 века аренда, кринолин напрокат, платье на бал Москва, историческое бальное платье',
  },
  vintage: {
    title: 'Аренда винтажных и свадебных платьев в Москве | Прокат от Кет',
    description: 'Прокат винтажных и свадебных платьев в Москве. Ретро 1920-х, 1960-х, богемный шик, эпоха модерн. Для фотосессий, выкупов и тематических мероприятий.',
    keywords: 'аренда винтажного платья Москва, прокат свадебного платья, ретро платья напрокат, 60-е 70-е платья аренда, богемный стиль аренда',
  },
  medieval: {
    title: 'Аренда средневековых и сказочных костюмов в Москве | Прокат от Кет',
    description: 'Прокат средневековых платьев, сказочных и фэнтези костюмов в Москве. Эльфийские, магические, ренессансные образы для фотосессий и косплея.',
    keywords: 'аренда средневекового платья Москва, прокат сказочного костюма, фэнтези костюм напрокат, косплей аренда Москва, ренессанс платье аренда',
  },
  fashion: {
    title: 'Аренда фэшн и будуарных платьев в Москве | Прокат от Кет',
    description: 'Прокат фэшн, будуарных и авангардных платьев в Москве. Чувственные и арт-образы для fashion-съёмок, look book и творческих фотопроектов.',
    keywords: 'аренда будуарного платья Москва, фэшн платья напрокат, art fashion фотосессия, авангард одежда аренда Москва',
  },
  riding: {
    title: 'Аренда костюмов для верховой езды в Москве | Прокат от Кет',
    description: 'Прокат исторических костюмов амазонки и для верховой езды в Москве. Редкая специализация: камзолы, амазонки, цилиндры. Для конных прогулок и фотосессий.',
    keywords: 'аренда костюма амазонки Москва, прокат костюма для верховой езды, исторический костюм амазонки, конная фотосессия образ',
  },
  mens: {
    title: 'Аренда мужских исторических костюмов в Москве | Прокат от Кет',
    description: 'Прокат мужских исторических костюмов в Москве: фраки, сюртуки, камзолы, мундиры. Эпохи от XVIII до XX века. Для фотосессий, тематических вечеринок и мероприятий.',
    keywords: 'аренда мужского исторического костюма Москва, прокат фрака, сюртук напрокат, мужской костюм 19 века аренда, прокат мундира',
  },
  accessories: {
    title: 'Аренда аксессуаров — веера, украшения, головные уборы | Прокат от Кет',
    description: 'Прокат аксессуаров для исторических образов в Москве: антикварные веера, украшения, броши, перчатки. Дополните образ из нашей коллекции.',
    keywords: 'аренда аксессуаров для фотосессии, прокат вееров Москва, антикварные украшения аренда, аксессуары для бального образа',
  },
  ethnic: {
    title: 'Аренда этнических украшений в Москве | Прокат от Кет',
    description: 'Прокат этнических и этно-бохо украшений в Москве. Индийские, восточные, кочевые украшения — идеальное дополнение к этническому образу для фотосессий.',
    keywords: 'аренда этнических украшений Москва, индийские украшения напрокат, бохо украшения аренда, восточные украшения прокат',
  },
  'ethnic-costumes': {
    title: 'Аренда этнических костюмов — сари, кимоно, мексиканские | Прокат от Кет',
    description: 'Прокат этнических костюмов в Москве: индийские сари, восточные платья, мексиканские и латиноамериканские образы. Идеально для тематических фотосессий.',
    keywords: 'аренда сари Москва, прокат этнического костюма, индийское платье напрокат, восточный костюм аренда, мексиканский костюм прокат',
  },
  kimono: {
    title: 'Аренда японских кимоно и юката в Москве | Прокат от Кет',
    description: 'Прокат традиционных японских кимоно и юката в Москве. Аутентичные женские кимоно для фотосессий, тематических вечеринок и фестивалей японской культуры.',
    keywords: 'аренда кимоно Москва, прокат юката, японское кимоно напрокат, кимоно для фотосессии, аренда японского костюма',
  },
  cloaks: {
    title: 'Аренда плащей и накидок в Москве | Прокат от Кет',
    description: 'Прокат плащей, пальто и накидок в Москве. Средневековые, викторианские, фэнтезийные — все размеры. Эффектные образы для фотосессий и тематических мероприятий.',
    keywords: 'аренда плаща Москва, прокат средневекового плаща, накидка напрокат, велюровый плащ аренда, театральный плащ Москва',
  },
  'belt-shoes': {
    title: 'Аренда поясов и обуви к историческим костюмам | Прокат от Кет',
    description: 'Прокат обуви и поясов для исторических образов в Москве. Туфли, ботинки, пояса и оби к бальным, кимоно и этническим костюмам.',
    keywords: 'аренда исторической обуви Москва, прокат обуви для фотосессии, пояс оби напрокат, обувь к историческому костюму',
  },
  'gloves-fans': {
    title: 'Аренда перчаток и вееров в Москве | Прокат от Кет',
    description: 'Прокат длинных перчаток и декоративных вееров в Москве. Атрибуты бального образа эпохи XIX века. Идеально для фотосессий и тематических балов.',
    keywords: 'аренда длинных перчаток Москва, прокат веера для фотосессии, бальные перчатки напрокат, испанский веер аренда',
  },
  headwear: {
    title: 'Аренда головных уборов — шляпы, цилиндры, кокошники | Прокат от Кет',
    description: 'Прокат исторических головных уборов в Москве: шляпы, цилиндры, кокошники, диадемы. Завершите образ деталью, которая сделает его незабываемым.',
    keywords: 'аренда шляпы Москва, прокат цилиндра, кокошник напрокат, диадема аренда фотосессия, исторический головной убор прокат',
  },
  furs: {
    title: 'Аренда меха и меховых изделий в Москве | Прокат от Кет',
    description: 'Прокат меховых накидок, палантинов и шуб в Москве. Роскошные меховые аксессуары для образов в стиле XIX-XX века, зимних фотосессий и торжеств.',
    keywords: 'аренда меховой накидки Москва, прокат меха для фотосессии, меховой палантин напрокат, шуба аренда Москва',
  },
};

const seo = categorySEO[category as string] ?? {
  title: `Аренда: ${categoryLabel} — Каталог платьев и костюмов | Прокат от Кет`,
  description: `Аренда и прокат в категории «${categoryLabel}». Более 400 уникальных образов для фотосессий и мероприятий в Москве. Прокат от Кет.`,
  keywords: 'прокат от Кет, аренда платьев Москва, аренда костюмов, прокат костюмов',
};
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  keywords={seo.keywords}
  canonicalUrl={`https://ketrent.ru/catalog/${category}`}
  schemaJson={combinedSchema}
  currentPage="catalog"
>
  <Header currentPage="catalog" />

  <section class="hero catalog-hero">
    <div class="hero-overlay"></div>
    <div class="container hero-container">
      <div class="breadcrumbs mb-6 inline-block">
        <a href="/catalog" class="btn btn-hero btn-catalog-back">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
            <path fill-rule="evenodd" d="M11.354 1.646a.5.5 0 0 1 0 .708L5.707 8l5.647 5.646a.5.5 0 0 1-.708.708l-6-6a.5.5 0 0 1 0-.708l6-6a.5.5 0 0 1 .708 0z"/>
          </svg>
          Весь каталог
        </a>
      </div>
      <h1 class="hero-title">Аренда: {categoryLabel}</h1>
      <p class="hero-subtitle">В наличии {categoryProducts.length} вариантов</p>
    </div>
  </section>

  <section class="section catalog-section">
    <div class="container">
      <div class="catalog-grid" id="catalogGrid" role="list">
        {categoryProducts.map((product: any) => {
            // Find its real global index for the client side modal to work
            const realIndex = products.findIndex(p => p.id === product.id);
            return (
              <ProductCard
                title={product.title}
                price={product.price}
                image={product.images?.[0] || ''}
                category={product.category}
                index={realIndex}
                id={product.id}
                slug={product.slug}
                description={product.description}
              />
            )
        })}
      </div>
    </div>
  </section>

  <Footer />

  <Fragment slot="scripts">
    <script is:inline>
      window.__catalogProducts = null;
    </script>
    <script>
      import '../../scripts/shared.js';
      import '../../scripts/mobile-nav.js';
      
      // Мини-версия catalog-client только для категории (без фильтров)
      import { initCategoryPage } from '../../scripts/category-client.js';
      document.addEventListener('DOMContentLoaded', initCategoryPage);
    </script>
  </Fragment>
</BaseLayout>
