---
interface Props {
  currentPage: 'home' | 'catalog';
}

const { currentPage } = Astro.props;

const categories = [
  { slug: '', label: 'Все товары' },
  { slug: 'ball', label: 'Бальные платья XVIII-XIX век' },
  { slug: 'vintage', label: 'Винтажные и свадебные платья' },
  { slug: 'fashion', label: 'Фэшн и Будуар' },
  { slug: 'medieval', label: 'Средневековые и Сказочные платья' },
  { slug: 'ethnic-costumes', label: 'Этнические Костюмы' },
  { slug: 'kimono', label: 'Японские кимоно женские' },
  { slug: 'riding', label: 'Костюмы для Верховой езды' },
  { slug: 'mens', label: 'Мужской Гардероб' },
  { slug: 'cloaks', label: 'Плащи и Накидки' },
  { slug: 'ethnic', label: 'Этнические украшения' },
  { slug: 'accessories', label: 'Аксессуары' },
  { slug: 'gloves-fans', label: 'Перчатки и веера' },
  { slug: 'belt-shoes', label: 'Пояса и Обувь' },
  { slug: 'furs', label: 'Мех' },
  { slug: 'headwear', label: 'Головные Уборы' },
];
---

<header class="header" slot="header">
  <div class="container header-content">
    <a href="/" class="logo">Прокат от Кет</a>
    <button
      class="burger-btn"
      id="burgerBtn"
      aria-label="Открыть меню"
      aria-expanded="false"
    >
      <span class="burger-line"></span>
      <span class="burger-line"></span>
      <span class="burger-line"></span>
    </button>
    <div class="nav-container" id="navContainer">
      <nav class="nav">
        {currentPage === 'home' ? (
          <>
            <a href="#about" class="nav-link">О нас</a>
            <a href="/catalog" class="nav-link">Каталог</a>
            <a href="/rules" class="nav-link">Правила Аренды</a>
            <a href="#contacts" class="nav-link js-open-contacts">Контакты</a>
          </>
        ) : (
          <>
            <a href="/" class="nav-link">Главная</a>
            <a href="/catalog" class="nav-link">Каталог</a>
            <a href="/rules" class="nav-link">Правила Аренды</a>
            <a href="/#contacts" class="nav-link js-open-contacts">Контакты</a>
          </>
        )}
      </nav>
      <div class="header-actions">
        <div class="header-contacts">
          <a href="tel:+79669826262" class="contact-link phone">+7 (966) 982-62-62</a>
        </div>
        <div class="catalog-dropdown">
          {currentPage === 'home' ? (
            <a href="/catalog" class="btn btn-primary btn-small">В каталог</a>
          ) : (
            <a href="/" class="btn btn-primary btn-small">На главную</a>
          )}
          <div class="catalog-dropdown-menu">
            {categories.map(cat => (
              <a
                href={cat.slug ? `/catalog/${cat.slug}` : '/catalog'}
                class="dropdown-item"
              >
                {cat.label}
              </a>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</header>
