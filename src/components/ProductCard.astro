---
interface Props {
  title: string;
  price: number | null;
  image: string;
  category: string;
  index: number;
  id: number;
  slug: string;
  description?: string;
}

const { title, price, image, category, index, id, slug, description } = Astro.props;

const formattedPrice = price != null ? price.toLocaleString('ru-RU') + ' ₽' : 'Нет данных';

const optimizedImage = image.includes('/upload/') 
  ? image.replace('/upload/', '/upload/f_auto,q_auto,w_500/') 
  : image;
---

<article
  class="catalog-card"
  role="listitem"
  data-category={category}
  data-index={index}
  data-id={id}
>
  <div class="card-image">
    <a href={`/product/${slug}`} class="image-seo-link" tabindex="-1" aria-hidden="true">
      <img
        src={optimizedImage}
        alt={`Аренда платья ${title} в Москве — Прокат от Кет`}
        loading="lazy"
        decoding="async"
        width="400"
        height="500"
        sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 400px"
      />
    </a>
  </div>
  <div class="card-body">
    <h3 class="card-title">
      <a href={`/product/${slug}`} class="seo-link" aria-label={title}>{title}</a>
    </h3>
    <p class="card-price">{formattedPrice}</p>
    <div class="card-actions">
      <button class="btn-text" data-product-index={index}>Подробнее &rarr;</button>
      <button class="btn-card-share" data-slug={slug} data-title={title} aria-label="Поделиться">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
          <path d="M13.5 1a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3M11 2.5a2.5 2.5 0 1 1 .603 1.628l-6.718 3.12a2.5 2.5 0 0 1 0 1.504l6.718 3.12a2.5 2.5 0 1 1-.488.876l-6.718-3.12a2.5 2.5 0 1 1 0-3.256l6.718-3.12A2.5 2.5 0 0 1 11 2.5m-8.5 4a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3m11 5.5a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3"/>
        </svg>
      </button>
    </div>
  </div>
</article>
