---
interface Props {
  title: string;
  price: number | null;
  image: string;
  category: string;
  index: number;
  id: number;
  description?: string;
}

const { title, price, image, category, index, id, description } = Astro.props;

const formattedPrice = price != null ? price.toLocaleString('ru-RU') + ' ₽' : 'Нет данных';

const optimizedImage = image.includes('/upload/') 
  ? image.replace('/upload/', '/upload/f_auto,q_auto,w_500/') 
  : image;
---

<article
  class="catalog-card"
  role="listitem"
  data-category={category}
  data-index={index}
  data-id={id}
>
  <div class="card-image">
    <img
      src={optimizedImage}
      alt={title}
      loading="lazy"
      decoding="async"
      width="400"
      height="500"
      sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 400px"
    />
  </div>
  <div class="card-body">
    <h3 class="card-title">{title}</h3>
    <p class="card-price">{formattedPrice}</p>
    <button class="btn-text" data-product-index={index}>Подробнее &rarr;</button>
  </div>
</article>
